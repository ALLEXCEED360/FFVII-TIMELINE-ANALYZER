{
  "name": "ffvii-timeline-analyzer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present run test",
    "validate": "node packages/data/src/cli/validate.ts data",
    "schemas": "node packages/data/src/cli/schemas.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm validate",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @ffvii/db generate",
    "db:migrate": "node packages/db/src/cli/migrate.ts",
    "db:seed": "node packages/db/src/cli/seed.ts data",
    "db:reset": "docker compose down --volumes && pnpm db:up && pnpm db:migrate && pnpm db:seed",
    "test:db": "pnpm --filter @ffvii/db run test:db"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
