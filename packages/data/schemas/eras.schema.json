{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "$ref": "#/$defs/__schema0"
      },
      "name": {
        "$ref": "#/$defs/__schema1"
      },
      "start": {
        "$ref": "#/$defs/__schema2"
      },
      "end": {
        "$ref": "#/$defs/__schema3"
      },
      "weight": {
        "$ref": "#/$defs/__schema4"
      }
    },
    "required": [
      "id",
      "name",
      "start",
      "end",
      "weight"
    ],
    "additionalProperties": false
  },
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^era_[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1
    },
    "__schema2": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "__schema3": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "__schema4": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  }
}
