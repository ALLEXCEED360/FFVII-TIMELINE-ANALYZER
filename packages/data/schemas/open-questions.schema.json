{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^question_[a-z0-9]+(_[a-z0-9]+)*$"
      },
      "kind": {
        "type": "string",
        "enum": [
          "needs_footage",
          "not_in_dataset",
          "structure"
        ]
      },
      "summary": {
        "type": "string",
        "minLength": 1
      },
      "details": {
        "type": "string",
        "minLength": 1
      },
      "entities": {
        "minItems": 1,
        "type": "array",
        "items": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "worlds": {
        "minItems": 1,
        "type": "array",
        "items": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "sources": {
        "minItems": 1,
        "type": "array",
        "items": {
          "$ref": "#/$defs/__schema2"
        }
      }
    },
    "required": [
      "id",
      "kind",
      "summary",
      "details"
    ],
    "additionalProperties": false
  },
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^(character|event|location|organization|arc)_[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^world_[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "__schema2": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema3"
        },
        {
          "$ref": "#/$defs/__schema6"
        },
        {
          "$ref": "#/$defs/__schema7"
        }
      ]
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "const": "og"
        },
        "disc": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "segment": {
          "type": "string",
          "pattern": "^og_[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "scene": {
          "$ref": "#/$defs/__schema4"
        },
        "optional": {
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": [
        "title",
        "disc",
        "segment"
      ],
      "additionalProperties": false
    },
    "__schema4": {
      "type": "string",
      "minLength": 1
    },
    "__schema5": {
      "type": "boolean",
      "const": true
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "enum": [
            "remake",
            "intermission",
            "rebirth"
          ]
        },
        "chapter": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "scene": {
          "$ref": "#/$defs/__schema4"
        },
        "optional": {
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": [
        "title",
        "chapter"
      ],
      "additionalProperties": false
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "enum": [
            "remake",
            "intermission",
            "rebirth"
          ]
        },
        "part": {
          "type": "string",
          "minLength": 1
        },
        "scene": {
          "$ref": "#/$defs/__schema4"
        },
        "optional": {
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": [
        "title",
        "part"
      ],
      "additionalProperties": false
    }
  }
}
